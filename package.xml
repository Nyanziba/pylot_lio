<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pylot_lio</name>
  <version>0.1.0</version>
  <description>
    Pluggable LiDAR-Inertial Odometry for Livox Mid-360 (PointCloud2 input).
    Provides switchable backends for preprocessor / point cloud map / registration /
    state estimator so that multiple algorithms (IESKF, HGO, GICP-only, small_gicp,
    plain GICP, SYCL GICP, VoxelMap, NormalMap, KdTreeMap, ...) can be compared on
    the same input under identical ROS interfaces (/lio/odom, /lio/cloud_world).
  </description>
  <maintainer email="katsuya.honda@oedodynamics.co.jp">PyLoT Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>

  <build_depend>small_gicp</build_depend>
  <exec_depend>small_gicp</exec_depend>

  <!-- オフライン rosbag リーダ (lio_rosbag) 用。 無い環境では CMake の
       find_package(QUIET) で lio_rosbag ビルドがスキップされる。 -->
  <depend>rosbag2_cpp</depend>

  <!-- Livox CustomMsg (input_cloud_format='livox_custom') 用。 macOS で
       livox_ros_driver2 がビルド不可な環境では CMake 側の find_package(QUIET)
       でフォールバックされる (CustomMsg 経路は無効化されるが PointCloud2 経路は動く)。 -->
  <build_depend>livox_ros_driver2</build_depend>
  <exec_depend>livox_ros_driver2</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
